{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "America/Denver",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "prCreation": "not-pending",
  "dependencyDashboard": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "vulnerability"
    ]
  },
  "packageRules": [
    {
      "groupName": "immich",
      "matchDepNames": [
        "ghcr.io/immich-app{/,}**"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major-update"
      ]
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "addLabels": [
        "docker-compose"
      ]
    },
    {
      "matchManagers": [
        "kubernetes",
        "flux",
        "helm-values"
      ],
      "addLabels": [
        "kubernetes"
      ]
    },
    {
      "description": "Ignore private GHCR images that Renovate cannot look up",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/jacob-roberts/nextjs-rendering-demo/server",
        "ghcr.io/jacob-roberts/social-signal-backend"
      ],
      "enabled": false
    }
  ],
  "ignoreDeps": [
    "ghcr.io/jacob-roberts/nextjs-rendering-demo/server",
    "ghcr.io/jacob-roberts/social-signal-backend"
  ]
}
